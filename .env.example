# WeatherGPT environment template — copy to .env and fill in.

APP_ENV=development
LOG_LEVEL=INFO
# 5173 = the demo-standard Flutter web dev port (frontend runs with
# `flutter run -d chrome --web-port=5173`). 8080 = the nginx web front end in
# infra/docker-compose.yml (it proxies /api on the same origin, so CORS is only
# needed if the PWA is built to call the API directly). Add any origin you serve from.
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173,http://localhost:8080

# IMD API Management Platform (https://api.imd.gov.in)
# A key is required (verified 2026-09-06: live endpoint returns "API key missing").
# Apply via the IMD APIs portal / SIH nodal channel — see docs/IMD-ACCESS.md.
IMD_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=
IMD_ENABLED=true

# Open-Meteo — free, no key. Fallback layer until the IMD key is granted.
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# MET Norway Locationforecast — free, no key, global. The second weather fallback:
# Open-Meteo's free tier allows ONE concurrent request per IP, so shared hosting
# egress can trip HTTP 429 for hours (see docs/DATA-SOURCES.md).
# The User-Agent must identify this app — see https://api.met.no/doc/TermsOfService
MET_NORWAY_BASE_URL=https://api.met.no
MET_NORWAY_USER_AGENT=WeatherGPT/0.1 (SIH 2026 prototype; +https://github.com/YasirTheJOD/WeatherGPT)

# SACHET — NDMA National Disaster Alert Portal (public CAP feed, ETag caching)
SACHET_BASE_URL=https://sachet.ndma.gov.in
SACHET_FEED_PATH=cap_public_website/rss/rss_india.xml

# IMD station snapshot (sample data until a live cityforecast_mapping capture)
STATION_SNAPSHOT_PATH=data/stations_sample.json

# Geocoding — Open-Meteo forward (keyless), BigDataCloud reverse (keyless)
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
REVERSE_GEOCODING_BASE_URL=https://api.bigdatacloud.net
CITIES_SEED_PATH=data/cities_seed.json

# LLM (Phase 5). "fallback" = deterministic no-LLM responder.
LLM_PROVIDER=fallback
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Rate limiting (Phase 6) — Redis fixed window per client IP. Fails open:
# with no Redis reachable, requests are never rejected (demo-safe). Behind a
# reverse proxy the first X-Forwarded-For hop is used as the client IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Deployment (optional) — serve a built Flutter web bundle from the API process,
# so the PWA and /api share ONE origin and a single public URL is enough
# (see docs/DEPLOYMENT.md §4b). Leave empty for the API-only default.
#   cd frontend && flutter build web --release --dart-define=API_BASE_URL=
#   cd backend  && WEB_DIR=../frontend/build/web python -m uvicorn app.main:app
WEB_DIR=

# Infra (Phase 3+). Under docker compose (infra/docker-compose.yml) these are
# overridden with the in-cluster service names
# (redis://redis:6379/0, ...@postgis:5432/weathergpt). See docs/DEPLOYMENT.md.
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://weathergpt:weathergpt@localhost:5432/weathergpt