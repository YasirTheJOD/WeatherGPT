# Secrets & env
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
# `pip install .` / `pip wheel .` stage a copy of the package here.
backend/build/

# Flutter / Dart
# Build output is ignored — except the deployable web bundle: the free host
# builds from Git and never runs Flutter, so frontend/build/web is committed
# (rebuild it with scripts/build_web.sh before pushing). See docs/DEPLOYMENT.md §9.
frontend/build/*
!frontend/build/web/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db